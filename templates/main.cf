compatibility_level = 3.7
daemon_directory = /usr/lib/postfix/sbin
data_directory = /var/lib/postfix
unknown_local_recipient_reject_code = 550
mynetworks = 127.0.0.0/8
smtpd_banner = $myhostname ESMTP $mail_name (x-ray)
inet_interfaces = all
home_mailbox = Maildir

virtual_mailbox_domains = mysql:/etc/postfix/virtual_domains.cf
virtual_mailbox_maps = mysql:/etc/postfix/virtual_users.cf
virtual_mailbox_base = /var/mail/virtual_domains
virtual_minimum_uid = 1113
virtual_uid_maps = static:1113
virtual_gid_maps = static:1113

content_filter=scan:[127.0.0.1]:${PORT}
receive_override_options = no_address_mappings
smtp_send_xforward_command=yes